# ---------------------------------------------------------------------------
# Market data (Pricecatcher)
# ---------------------------------------------------------------------------
VITE_PRICECATCHER_API_BASE_URL=https://pricecatcher.dotone.online
# Browser-public, origin-restricted consumer key only. Never put private/admin keys here.
VITE_PRICECATCHER_PUBLIC_API_KEY=
VITE_COIN_API_IMAGE_URL=https://pricing.dotone.online

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:5173
VITE_DOTONE_EXPLORER_URL=https://dotscan.one

# ---------------------------------------------------------------------------
# DotOne chain + our own AMM contracts — public on-chain addresses, safe to
# keep the real defaults. Read through config/env.ts and
# data/contracts/addresses.ts; Vite inlines these at BUILD time.
# ---------------------------------------------------------------------------
VITE_RPC_URL=https://rpc.dotone.online
VITE_CHAIN_ID=505

VITE_V2_ROUTER=0x63b76b550FF13b8B681E65C1C5eC7D4cf30143f7
VITE_V2_FACTORY=0xD728243a996C615a44Eedcd40AE311083B9b9279
VITE_WDOTO_ADDRESS=0x044b2ED77214aeA517e811f5c80980511F8ff326

VITE_V3_POSITION_MANAGER=0x352ca10c009FfCaB092d5916A58564dE0b949F57
VITE_V3_SWAP_ROUTER=0x9d34Fe7BE11A8aa53B9a305Cf8450011Fe7be3bC
VITE_V3_QUOTER=0x72A8d19277D3d732e943E626AD6338D14648a773
VITE_V3_FACTORY=0x97Dbc1528EBa37d8c35ae54Bd21F2C9Fe08d6e5E
# Earliest block the V3 factory could have emitted a PoolCreated event.
VITE_V3_FACTORY_DEPLOY_BLOCK=2483938

# This chain's own Multicall3 deployment (not the canonical singleton).
VITE_MULTICALL3=0xe345E23D099203B2aC01DC7EA71eEb84f4c1D13A

# ---------------------------------------------------------------------------
# LI.FI (routed-network swaps + the pool listing's token vetting)
# ---------------------------------------------------------------------------
VITE_LIFI_INTEGRATOR=dot-swap
VITE_LIFI_API_KEY=
VITE_LIFI_FEE=0.001

# Public RPCs for the LI.FI networks (data/lifi.ts).
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org
VITE_ETH_RPC_URL=https://eth.llamarpc.com
VITE_POLYGON_RPC_URL=https://polygon-rpc.com
VITE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ---------------------------------------------------------------------------
# DeFiLlama pools index (data/pools/defiLlamaPools.ts) — no key, no auth.
# ---------------------------------------------------------------------------
VITE_DEFILLAMA_POOLS_URL=https://yields.llama.fi/pools
